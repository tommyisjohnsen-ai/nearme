{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Lekseplan",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "5500", "--directory", "frontend"],
      "port": 5500
    },
    {
      "name": "Frontend (React – nearme-frontend)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start", "--prefix", "frontend"],
      "port": 3000
    },
    {
      "name": "Backend (Express + Socket.io – nearme-backend)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "backend"],
      "port": 4000
    }
  ]
}
