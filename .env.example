# NearMe — Environment Variables
# Copy to .env and fill in all values before running docker compose

# ── Required ──────────────────────────────────────────────────────────────────

# Strong random string — generate with: openssl rand -hex 32
JWT_SECRET=

# VAPID Keys for Web Push (generate with: sh generate-vapid.sh)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Optional (have sensible defaults) ─────────────────────────────────────────

# Database password (change in production)
DB_PASSWORD=nearme_secret

# Your public-facing URL
FRONTEND_URL=http://localhost:3000
REACT_APP_BACKEND_URL=http://localhost:4000

VAPID_EMAIL=mailto:admin@nearme.app
