# Supabase — copy from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...

# Web Push — generate with `pnpm vapid:generate`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@example.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Geo defaults — Oslo sentrum
NEXT_PUBLIC_DEFAULT_LAT=59.9139
NEXT_PUBLIC_DEFAULT_LNG=10.7522
NEXT_PUBLIC_DEFAULT_RADIUS_M=3000
